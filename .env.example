GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
DATABASE_URL=sqlite:///./inbox_router.db
PGSSLMODE=require
# Tenant/workspace identifier. Any string works — no need to be a real email.
# The frontend lets users switch candidate_id live; leave this unset to use
# the generic default (demo@dispatchdesk.ai).
CANDIDATE_ID=
# Optional bearer token. When set, ALL data endpoints (ingest, tasks, stats,
# chat, users) require "Authorization: Bearer <API_TOKEN>". Frontend / health
# endpoints stay public. Leave empty for local development.
API_TOKEN=
